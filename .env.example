APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///backend/bookwise.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_TOKEN_MAX_AGE=86400
# Local HTTP keeps Secure off; production startup forces Secure cookies on.
AUTH_COOKIE_SECURE=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_FEEDBACK_MAX=60
RATE_LIMIT_RATING_MAX=30
PORT=8000
